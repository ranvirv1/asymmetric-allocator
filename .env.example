# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Free keys: FRED https://fred.stlouisfed.org/docs/api/api_key.html
#            FMP  https://site.financialmodelingprep.com/developer/docs
#            Finnhub https://finnhub.io/dashboard
FRED_API_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=
# Optional, live mode only (not needed for the backtest):
ALPACA_API_KEY=
ALPACA_API_SECRET=

# --- ES/NQ Futures Bot ---
# NinjaTrader webhook bridge
NINJATRADER_WEBHOOK_URL=
NINJATRADER_WEBHOOK_SECRET=
# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email alerts (optional)
SMTP_PASSWORD=
